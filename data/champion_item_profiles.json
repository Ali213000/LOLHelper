    "ad", "ap", "attack_speed", "crit", "on_hit",
    "lethality", "armor_pen_pct", "magic_pen_flat", "magic_pen_pct",
    "ability_haste", "mana", "health", "armor", "mr",
    "lifesteal", "omnivamp", "heal_shield_power", "movespeed"
  ],

  "flags": {
    "crit_viable": "l'achat de coup critique a du sens sur ce champion",
    "on_hit": "les effets a l'impact se declenchent utilement",
    "uses_mana": "false = energie, fureur, sang, ou sans ressource",
    "auto_based": "degats majoritairement par attaques de base",
    "stacks_hp": "profite anormalement des PV (ratios PV, Sterak, Coeur gele)"
  },

